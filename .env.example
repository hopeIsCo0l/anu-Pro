# Copy to .env and fill in values. Never commit .env.

# Server
PORT=8080
ENV=development

# Database (Postgres 16)
DATABASE_URL=postgres://anu:anu@localhost:5432/anu?sslmode=disable

# Auth
JWT_SECRET=dev-secret-at-least-32-chars-change-in-prod
JWT_ACCESS_EXPIRY_MIN=15
JWT_REFRESH_EXPIRY_DAYS=30

# Storage — S3-compatible (MinIO locally, Cloudflare R2 in prod)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=anu-dev
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=us-east-1

# Logging (debug | info | warn | error)
LOG_LEVEL=debug
